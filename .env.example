# Copy to .env and fill in. Never commit .env.
# The server reads these once, in server/config.js.

PORT=3000

# Public URL the browser reaches this server on. Used for the PayPal
# return/cancel URLs and as the default CORS origin.
PUBLIC_ORIGIN=http://localhost:3000

# Comma-separated CORS allow-list. Defaults to PUBLIC_ORIGIN.
# ALLOWED_ORIGINS=https://takekontrol.de,https://www.takekontrol.de

# sandbox | live
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=BAAziCxiNP9jiO7LOwLT9UL34htwcmWsu5F28zsBRJgA5nKZ33U-twN5G6guae28iUJyCYq0ZzmI06BZD4
PAYPAL_CLIENT_SECRET=ELhUOjum22L4tiR2qzop4d9WRDCq3HPpvbEVcptLJBvlUoCHCHLJUXSmM8vychnqpCFQPrXvPmSM4l1a
PAYPAL_WEBHOOK_ID=
PAYPAL_TIMEOUT_MS=15000

# Where the append-only order log lives. Back this up.
DATA_DIR=./data

# Static files served at /
STATIC_DIR=./public

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Enquiry form → DynamoDB
# IMPORTANT: Rotate the old AKIA6GBMBKXGGNAOVBHA key in AWS IAM immediately.
# Generate a new key scoped to DynamoDB PutItem only on TakeKONTROL_enquiries.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE=TakeKONTROL_enquiries
